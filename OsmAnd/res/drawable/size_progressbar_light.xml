<?xml version="1.0" encoding="utf-8"?>
<!-- MineNAV: rounded usage bar in the accent color -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:id="@android:id/background">
		<shape>
			<corners android:radius="@dimen/content_padding_small" />
			<solid android:color="@color/mn_field_bg_light" />
		</shape>
	</item>
	<item android:id="@android:id/progress">
		<clip>
			<shape>
				<corners android:radius="@dimen/content_padding_small" />
				<solid android:color="@color/mn_primary" />
			</shape>
		</clip>
	</item>
</layer-list>
