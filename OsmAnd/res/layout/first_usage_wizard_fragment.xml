<?xml version="1.0" encoding="utf-8"?>
<!-- MineNAV: the first-run screen as a Waze-like welcome: the mascot, a short text, the suggested map
     in a rounded card and pill buttons. Colors are set by MineNavFirstRun. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/first_usage_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/list_background_color"
	android:clickable="true"
	android:focusable="true"
	android:orientation="vertical">

	<ScrollView
		android:id="@+id/scroll_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="@dimen/content_padding"
			android:paddingBottom="@dimen/content_padding">

			<FrameLayout
				android:id="@+id/toolbar_container"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/content_padding_small">

				<ImageButton
					android:id="@+id/actions_button"
					android:layout_width="@dimen/acceptable_touch_radius"
					android:layout_height="@dimen/acceptable_touch_radius"
					android:layout_gravity="end"
					android:contentDescription="@string/shared_string_other"
					android:padding="@dimen/content_padding_small"
					android:scaleType="fitCenter"
					app:srcCompat="@drawable/ic_overflow_menu_white" />

			</FrameLayout>

			<androidx.appcompat.widget.AppCompatImageView
				android:id="@+id/logo"
				android:layout_width="@dimen/splash_mascot_size"
				android:layout_height="@dimen/splash_mascot_size"
				android:layout_gravity="center_horizontal"
				android:importantForAccessibility="no"
				app:srcCompat="@drawable/ic_minenav_mascot" />

			<TextView
				android:id="@+id/welcome_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/content_padding"
				android:fontFamily="@font/nunito_bold"
				android:gravity="center"
				android:text="@string/mn_welcome_title"
				android:textSize="@dimen/splash_title_text_size"
				app:fontFamily="@font/nunito_bold" />

			<TextView
				android:id="@+id/wizard_description"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/content_padding_small"
				android:gravity="center"
				android:text="@string/first_usage_wizard_desc"
				android:textSize="@dimen/default_list_text_size" />

			<LinearLayout
				android:id="@+id/wizard_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/mn_section_gap"
				android:orientation="vertical"
				android:padding="@dimen/content_padding">

				<LinearLayout
					android:id="@+id/wizard_layout"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:minHeight="@dimen/mn_settings_icon_circle"
					android:orientation="horizontal">

					<ProgressBar
						android:id="@+id/wizard_progress_bar_icon"
						android:layout_width="@dimen/mn_settings_icon_circle"
						android:layout_height="@dimen/mn_settings_icon_circle"
						android:indeterminate="true"
						android:padding="@dimen/content_padding_half"
						android:visibility="gone" />

					<androidx.appcompat.widget.AppCompatImageView
						android:id="@+id/wizard_icon"
						android:layout_width="@dimen/mn_settings_icon_circle"
						android:layout_height="@dimen/mn_settings_icon_circle"
						android:padding="@dimen/content_padding_half"
						android:scaleType="fitCenter"
						app:srcCompat="@drawable/ic_map" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="@dimen/content_padding"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:id="@+id/wizard_title"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:fontFamily="@font/nunito_bold"
							android:textSize="@dimen/mn_place_title_size"
							app:fontFamily="@font/nunito_bold"
							tools:text="Malaysia" />

						<ProgressBar
							android:id="@+id/wizard_progress_bar"
							style="?android:attr/progressBarStyleHorizontal"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/content_padding_small_half"
							android:visibility="visible" />

					</LinearLayout>

					<ImageButton
						android:id="@+id/location_button"
						android:layout_width="@dimen/acceptable_touch_radius"
						android:layout_height="@dimen/acceptable_touch_radius"
						android:layout_marginStart="@dimen/content_padding_small"
						android:contentDescription="@string/shared_string_location"
						android:padding="@dimen/content_padding_small"
						android:scaleType="fitCenter"
						app:srcCompat="@drawable/ic_action_my_location" />

				</LinearLayout>

				<net.osmand.plus.widgets.dialogbutton.DialogButton
					android:id="@+id/wizard_action_button"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/content_padding"
					android:gravity="center"
					app:dialogButtonHeight="@dimen/route_preview_button_height"
					tools:dialogButtonTitle="@string/shared_string_download"
					tools:dialogButtonType="primary" />

			</LinearLayout>

			<net.osmand.plus.widgets.TextViewEx
				android:id="@+id/terms_of_service_description"
				style="@style/DescStyle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/content_padding"
				android:gravity="center"
				android:text="@string/terms_of_service_desc" />

			<View
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:minHeight="@dimen/content_padding" />

			<androidx.appcompat.widget.AppCompatButton
				android:id="@+id/skip_button"
				android:layout_width="match_parent"
				android:layout_height="@dimen/route_preview_button_height"
				android:fontFamily="@font/nunito_bold"
				android:stateListAnimator="@null"
				android:text="@string/skip_download"
				android:textAllCaps="false"
				android:textSize="16sp" />

		</LinearLayout>

	</ScrollView>

</LinearLayout>
