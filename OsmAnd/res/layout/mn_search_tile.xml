<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="@dimen/mn_search_tile_width"
	android:layout_height="@dimen/mn_search_tile_height"
	android:layout_marginEnd="@dimen/content_padding_small"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center"
	android:orientation="vertical">

	<ImageView
		android:id="@+id/tile_icon"
		android:layout_width="@dimen/mn_search_tile_icon"
		android:layout_height="@dimen/mn_search_tile_icon"
		android:importantForAccessibility="no" />

	<TextView
		android:id="@+id/tile_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/content_padding_half"
		android:maxLines="1"
		android:textSize="@dimen/default_list_text_size" />

</LinearLayout>
