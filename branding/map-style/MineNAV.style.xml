<?xml version="1.0" encoding="utf-8"?>
<!-- MineNAV map style: a clean, Waze-like map on top of the OsmAnd default style. Only water and parks keep a
     color, roads are white with grey outlines, and labels are calm grey. Copied into the app as
     MineNAV.render.xml by OsmAnd-java/build.gradle. Generated by branding/map-style/make_style.py. -->
<renderingStyle name="MineNAV" depends="default" defaultColor="#F4F4F2" version="1">

	<renderingAttribute name="defaultColor">
		<case noPolygons="true" attrColorValue="#00F4F4F2"/>
		<case nightMode="true" attrColorValue="#1E2735"/>
		<case attrColorValue="#F4F4F2"/>
	</renderingAttribute>

	<!-- Waze-like purple route line; color_0 is the outline, color_2 the direction arrows, color_3 the turn arrows -->
	<renderingAttribute name="route">
		<case color="#CC7B3FF2" strokeWidth="12:8" color_0="#E05B21B6" strokeWidth_0="14:8" color_2="#E9DDFF" color_3="#FFFFFF" strokeWidth_3="5:7">
			<apply_if nightMode="true" color="#CCA78BFA" color_0="#E06D28D9" color_2="#3B2A66" color_3="#FFFFFF"/>
		</case>
	</renderingAttribute>

